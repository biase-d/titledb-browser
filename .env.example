# Every variable here is read at runtime, through $env/dynamic/private. None of
# them are needed to build the image, and none are baked into it

# Database
POSTGRES_URL="postgres://postgres:postgres@localhost:5432/main"

# Server (adapter-node). ORIGIN is required behind a reverse proxy: without it
# form actions and the auth callback are rejected as cross-site
HOST="0.0.0.0"
PORT="3000"
ORIGIN="https://your-domain.com"
BODY_SIZE_LIMIT="Infinity"

# Object storage — Garage, or any S3-compatible store.
# Leave S3_ENDPOINT unset in development and the filesystem is used instead.
# Holds the derived-asset caches: resized artwork and rendered OG images
S3_ENDPOINT="http://garage:3900"
S3_BUCKET="titledb-assets"
S3_ACCESS_KEY_ID="GK..."
S3_SECRET_ACCESS_KEY="..."
# Whatever region the Garage cluster was configured with. Not an AWS region,
# it only has to match the server
S3_REGION="garage"
# Optional: Garage's web endpoint, if the bucket is exposed publicly. Only used
# to build absolute URLs; the app serves bytes through its own routes regardless
S3_PUBLIC_URL="https://assets.your-domain.com"
# Base directory for the development filesystem fallback
STORAGE_PATH="./storage"

# GitHub
GITHUB_BOT_TOKEN="your_github_pat"
GITHUB_ID="oauth_client_id"
GITHUB_SECRET="oauth_client_secret"
AUTH_SECRET="auth_secret_random_string"
# Read by scripts/build.js (via the pipeline) to raise the GitHub API rate limit
ACCESS_TOKEN="your_github_pat"

# Signs the GitHub webhook that marks merged PRs as approved
INTERNAL_WEBHOOK_SECRET="a_long_random_string"

# Signs the webhook from the nx-performance repository that starts a sync.
# Falls back to INTERNAL_WEBHOOK_SECRET when unset, but a separate secret per
# sender is better: they are configured in different repositories
PIPELINE_WEBHOOK_SECRET="a_long_random_string"

# Guards /api/v1/requests/backup
CRON_SECRET="a_long_random_string"

# Days of log files to keep under data/logs (0 disables pruning)
LOG_RETENTION_DAYS="14"

# Error alerting (optional - skipped entirely when unset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="alerts@example.com"
SMTP_PASS="smtp_password"
ALERT_EMAIL_TO="you@example.com"

# Monitoring webhook (optional - see "Monitoring" in the README)
# Every logger.error is POSTed here as JSON, throttled to one per distinct
# message per 5 minutes. n8n: add a Webhook node and paste its Production URL
N8N_WEBHOOK_URL="https://n8n.example.com/webhook/titledb-browser"
# Sent as `Authorization: Bearer ...` when set. Use it with n8n's Header Auth
# credential so the webhook is not open to the internet
N8N_WEBHOOK_TOKEN="a_long_random_string"

# Pipeline flags. Normally set by scripts/build.js from its arguments
# (--full-rebuild, --no-cache) rather than configured here
# PIPELINE_FULL_REBUILD="false"
# PIPELINE_NO_CACHE="false"
# Skips the data sync entirely, for exercising the schema plumbing alone
# PIPELINE_SKIP_DATA="false"
