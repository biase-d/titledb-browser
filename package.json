{
	"name": "nx-performance-ui",
	"private": true,
	"version": "3.0.0",
	"type": "module",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build:flags": "node scripts/build-flag-icons.js",
		"build:index": "node scripts/build.js",
		"build": "npm run build:flags && vite build",
		"preview": "vite preview",
		"dev:seed": "npm run build:index",
		"prepare": "npm run build:flags && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "eslint \"src/**/*.{js,ts,svelte}\"",
		"lint:fix": "eslint \"src/**/*.{js,ts,svelte}\" --fix",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/circle-flags": "^1.2.11",
		"@iconify-json/flag": "^1.2.12",
		"@iconify/svelte": "^5.0.1",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^22.20.4",
		"@typescript-eslint/parser": "^8.38.0",
		"@vitest/ui": "5.0.1",
		"dotenv": "^18.0.3",
		"drizzle-kit": "^0.31.4",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^17.12.0",
		"jsdom": "^29.1.1",
		"simple-git": "^3.28.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-eslint-parser": "^1.3.0",
		"typescript": "^5.0.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.10.0",
		"@fontsource-variable/caveat": "^5.2.6",
		"@fontsource-variable/inter": "^5.2.6",
		"@fontsource/fira-mono": "^5.2.6",
		"@fontsource/noto-sans-jp": "^5.2.9",
		"@neondatabase/serverless": "^1.0.2",
		"@octokit/rest": "^22.0.0",
		"@vercel/blob": "^2.0.0",
		"chart.js": "^4.5.0",
		"drizzle-orm": "^0.45.3",
		"idb": "^8.0.3",
		"json-stable-stringify": "^1.3.0",
		"lodash-es": "^4.17.21",
		"node-vibrant": "^4.0.4",
		"nodemailer": "^10.0.10",
		"postgres": "^3.4.7",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.4",
		"workers-og-custom": "github:biase-d/workers-og-custom"
	},
	"overrides": {
		"@auth/sveltekit": {
			"nodemailer": "$nodemailer"
		}
	}
}
